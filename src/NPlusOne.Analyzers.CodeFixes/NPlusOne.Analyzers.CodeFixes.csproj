<Project Sdk="Microsoft.NET.Sdk">
  <!-- Code fixes need the Workspaces layer, which the compiler does not load; they live apart from the analyzer. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RootNamespace>NPlusOne.Analyzers.CodeFixes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <ProjectReference Include="../NPlusOne.Analyzers/NPlusOne.Analyzers.csproj" />
  </ItemGroup>
</Project>
